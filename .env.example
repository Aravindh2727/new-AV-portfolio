# ========================================================
# FIREBASE WEB CONFIGURATION
# (Obtained from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
# ========================================================
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-portfolio-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-portfolio-id
VITE_FIREBASE_STORAGE_BUCKET=your-portfolio-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789

# ========================================================
# CLOUDINARY CONFIGURATION (AUTHENTICATED SIGNED UPLOAD)
# (Obtained from Cloudinary Console -> Dashboard)
# Never expose the API Secret here! It must be stored in Firebase Secret Manager.
# ========================================================
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_public_api_key

# ========================================================
# APPLICATION INTER-CONNECTIVITY URLS
# ========================================================
VITE_PORTFOLIO_URL=http://localhost:5173
VITE_SHOWCASE_URL=http://localhost:5174
VITE_ADMIN_URL=http://localhost:5175


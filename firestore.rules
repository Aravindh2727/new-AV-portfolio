rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is an authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Validation helper for contact message inputs
    function isValidContactMessage() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 120 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 3000;
    }

    // 1. Profile and Global Settings
    match /portfolio/{document=**} {
      // Public can read portfolio profile and settings
      allow read: if true;
      // Only authenticated admin can write/update
      allow write: if isAdmin();
    }

    // 2. Projects Collection
    match /projects/{projectId} {
      // Public can only read published projects. Admins can read all (including drafts)
      allow read: if (resource.data.published == true) || isAdmin();
      // Only authenticated admin can create, update, or delete projects
      allow write: if isAdmin();
    }

    // 3. Skills Collection
    match /skills/{skillId} {
      allow read: if (resource.data.published == true) || isAdmin();
      allow write: if isAdmin();
    }

    // 4. Education Collection
    match /education/{educationId} {
      allow read: if (resource.data.published == true) || isAdmin();
      allow write: if isAdmin();
    }

    // 5. Experience Collection
    match /experience/{experienceId} {
      allow read: if (resource.data.published == true) || isAdmin();
      allow write: if isAdmin();
    }

    // 6. Certifications Collection
    match /certifications/{certId} {
      allow read: if (resource.data.published == true) || isAdmin();
      allow write: if isAdmin();
    }

    // 7. Achievements Collection
    match /achievements/{achievementId} {
      allow read: if (resource.data.published == true) || isAdmin();
      allow write: if isAdmin();
    }

    // 8. Contact Messages Collection
    match /contactMessages/{messageId} {
      // Any public visitor can submit a valid contact message
      allow create: if isValidContactMessage();
      // Only authenticated admin can read, update (mark read), or delete messages
      allow read, update, delete: if isAdmin();
    }

    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
